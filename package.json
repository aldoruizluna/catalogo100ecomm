{
  "dependencies": {
    "@astrojs/node": "^9.1.3",
    "@astrojs/tailwind": "^6.0.2",
    "animejs": "^4.0.1",
    "astro": "^5.6.1",
    "better-sqlite3": "^11.9.1",
    "drizzle-orm": "^0.41.0",
    "dotenv": "^16.1.4",
    "tailwindcss": "^3.4.17"
  },
  "scripts": {
    "db:test": "npx tsx src/db/test.ts",
    "db:seed": "npx tsx src/db/seed.ts",
    "db:reset": "rm -f src/db/dev.db && npm run db:seed",
    "dev": "npm run db:seed && astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:api": "start-server-and-test --timeout=60000 npm:dev http://localhost:3000/api/courses npm:test",
    "lint": "eslint . --ext .js,.ts,.astro",
    "format": "prettier --write . --plugin=prettier-plugin-astro",
    "prepare": "husky install",
    "prestart": "npm run db:seed",
    "start": "node .output/server/index.js"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.24.0",
    "eslint-plugin-astro": "^1.3.1",
    "husky": "^9.1.4",
    "lint-staged": "^15.2.10",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "start-server-and-test": "^2.0.11",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "vitest": "^3.1.1"
  },
  "lint-staged": {
    "*.{js,ts,astro}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
