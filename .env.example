# Example environment variables for production deployment

# Node environment
NODE_ENV=production

# Path to database file (optional, default based on NODE_ENV)
# Example: DB_PATH=./data/prod.db
DB_PATH=

# Deployment base path (for GitHub Pages or other subdirectories)
# Example: BASE_PATH=/catalogo100ecomm
BASE_PATH=

# Site URL (for sitemaps, canonical URLs)
# Example: SITE_URL=https://aldoruizluna.github.io
SITE_URL=
