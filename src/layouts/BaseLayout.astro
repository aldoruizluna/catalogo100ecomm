---
import Head from '../components/Head.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <Head {title} />
  </head>
  <body class="font-sans">
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
