---

<footer class="bg-gray-900 text-gray-400 py-12 px-4 md:px-12">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
      <!-- Brand Info -->
      <div>
        <h3 class="text-3xl font-bold tracking-wider mb-4">
          <span class="text-green-400">MAD</span>
          <span class="text-blue-400">F</span>
          <span class="text-orange-400">AM</span>
        </h3>
        <p class="mb-6">
          Plataforma educativa especializada en manufactura sostenible y
          transformación digital.
        </p>

        <div class="flex space-x-4">
          <a
            href="#"
            class="w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center hover:bg-gray-700 transition-colors"
            aria-label="Facebook"
          >
            <i class="fab fa-facebook-f"></i>
          </a>
          <a
            href="#"
            class="w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center hover:bg-gray-700 transition-colors"
            aria-label="Twitter"
          >
            <i class="fab fa-twitter"></i>
          </a>
          <a
            href="#"
            class="w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center hover:bg-gray-700 transition-colors"
            aria-label="Instagram"
          >
            <i class="fab fa-instagram"></i>
          </a>
          <a
            href="#"
            class="w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center hover:bg-gray-700 transition-colors"
            aria-label="LinkedIn"
          >
            <i class="fab fa-linkedin-in"></i>
          </a>
        </div>
      </div>

      <!-- Categories -->
      <div>
        <h3 class="text-xl font-semibold mb-6">Categorías</h3>
        <ul class="space-y-3">
          <li>
            <a href="#fabricacion" class="hover:text-white transition-colors"
              >Fabricación Sostenible</a
            >
          </li>
          <li>
            <a href="#transformacion" class="hover:text-white transition-colors"
              >Transformación Digital</a
            >
          </li>
          <li>
            <a href="#solarpunk" class="hover:text-white transition-colors"
              >Filosofía Solarpunk</a
            >
          </li>
          <li>
            <a
              href="#certificaciones"
              class="hover:text-white transition-colors"
              >Certificaciones SEP/CONOCER</a
            >
          </li>
        </ul>
      </div>

      <!-- Information -->
      <div>
        <h3 class="text-xl font-semibold mb-6">Información</h3>
        <ul class="space-y-3">
          <li>
            <a href="#" class="hover:text-white transition-colors"
              >Sobre Nosotros</a
            >
          </li>
          <li>
            <a href="#" class="hover:text-white transition-colors"
              >Metodología Educativa</a
            >
          </li>
          <li>
            <a href="#" class="hover:text-white transition-colors"
              >Modalidades de Estudio</a
            >
          </li>
          <li>
            <a href="#" class="hover:text-white transition-colors"
              >Preguntas Frecuentes</a
            >
          </li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h3 class="text-xl font-semibold mb-6">Contacto</h3>
        <ul class="space-y-3">
          <li class="flex items-start">
            <i class="fas fa-map-marker-alt mt-1 mr-3"></i>
            <span>Ciudad de México, México</span>
          </li>
          <li class="flex items-start">
            <i class="fas fa-envelope mt-1 mr-3"></i>
            <span
              ><a href="mailto:contacto@madfam.com" class="hover:text-white"
                >contacto@madfam.com</a
              ></span
            >
          </li>
          <li class="flex items-start">
            <i class="fas fa-phone-alt mt-1 mr-3"></i>
            <span>+52 55 1234 5678</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-gray-800 mt-12 pt-8 text-center">
      <p>&copy; 2025 MADFAM. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>
