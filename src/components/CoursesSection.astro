---
import CourseCard from './CourseCard.astro';
import type { Course } from '../types'; // Import the shared type

/**
 * CoursesSection Component
 *
 * Displays a filterable grid of courses using CourseCard components.
 * Includes client-side filtering and animations via anime.js.
 *
 * @prop {Course[]} courses - An array of course objects to display.
 */

export interface Props {
  courses: Course[];
}

const { courses } = Astro.props;

console.log(
  `ℹ️ [CoursesSection] Received ${courses.length} courses:`,
  JSON.stringify(courses, null, 2)
);

// Filter unique categories from courses for the filter buttons
const categories = [...new Set(courses.map((course) => course.category))];

console.log(
  `ℹ️ [CoursesSection] Extracted ${categories.length} unique categories:`,
  categories
);

// Client-side script for filtering and animations
---

<!-- Include anime.js from CDN -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.min.js"
></script>

<script>
  // Add TypeScript declaration for the global anime object from the CDN
  declare global {
    interface Window {
      anime: any; // Use 'any' as we don't have types for the CDN version
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    // Ensure anime.js is loaded before using it
    if (typeof window.anime === 'undefined') {
      console.error('anime.js not loaded');
      return;
    }
    // Reference the global anime object (cast to 'any' to avoid TS errors)
    const anime = (window as any).anime;
    const categoryButtons =
      document.querySelectorAll<HTMLElement>('.category-button');
    const courseCardWrappers = document.querySelectorAll<HTMLElement>(
      '.course-card-wrapper'
    );

    /**
     * Filters course cards based on the selected category and applies animations.
     * @param {string} category - The category to filter by ('Todos' shows all).
     */
    function filterCourses(category: string | undefined | null) {
      if (!category) return; // Safety check

      courseCardWrappers.forEach((cardWrapper) => {
        const courseCategory = cardWrapper.dataset.courseCategory; // Read category from data attribute
        const match = category === 'Todos' || courseCategory === category;

        // Animate opacity for fade-in/fade-out effect
        anime({
          targets: cardWrapper,
          opacity: match ? [0, 1] : [1, 0], // Fade in if match, fade out if not
          duration: 300,
          easing: 'easeOutQuad',
          // Use begin/complete callbacks to manage display property for layout flow
          begin: () => {
            if (match) cardWrapper.style.display = ''; // Show card before fade-in
          },
          complete: () => {
            if (!match) cardWrapper.style.display = 'none'; // Hide card after fade-out
          },
        });
      });
    }

    // Add click event listeners to category filter buttons
    categoryButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const category = button.dataset.category; // Get category from button's data attribute
        if (category) {
          // Update active state styling for buttons
          categoryButtons.forEach(
            (btn) =>
              btn.classList.remove(
                'bg-blue-500',
                'text-white',
                'border-blue-500'
              ) // Remove active styles
          );
          button.classList.add('bg-blue-500', 'text-white', 'border-blue-500'); // Add active styles

          // Filter the course cards
          filterCourses(category);
        }
      });
    });

    // --- Initial Setup ---
    // Find the 'Todos' button and set it as active initially
    const initialButton = document.querySelector<HTMLElement>(
      '.category-button[data-category="Todos"]'
    );
    if (initialButton) {
      initialButton.classList.add(
        'bg-blue-500',
        'text-white',
        'border-blue-500'
      );
    }
    // Perform initial filter to show all courses
    filterCourses('Todos');

    // Apply initial load animation to cards
    anime({
      targets: '.course-card-wrapper',
      translateY: [20, 0], // Animate from slightly below
      opacity: [0, 1], // Fade in
      delay: anime.stagger(50), // Stagger animation for each card
      easing: 'easeOutExpo',
    });
  });
</script>

<!-- Courses Section -->
<section id="cursos" class="py-20 px-4 md:px-12 bg-gray-50 section-container">
  <div class="max-w-7xl mx-auto">
    <h2 class="text-4xl font-bold text-center mb-16 relative">
      Nuestros <span class="text-blue-600">Cursos</span>
      <span
        class="absolute bottom-0 left-1/2 w-20 h-1 bg-blue-500 transform -translate-x-1/2 mt-2"
      ></span>
    </h2>

    <!-- Category Filters -->
    <div class="flex flex-wrap justify-center gap-3 mb-12 animate-element">
      <button
        class="category-button px-6 py-2 rounded-full border-2 border-gray-300 text-gray-700 font-medium hover:border-blue-500 hover:text-blue-500 transition-all"
        data-category="Todos"
      >
        Todos
      </button>
      {
        categories.map((category) => (
          <button
            class="category-button px-6 py-2 rounded-full border-2 border-gray-300 text-gray-700 font-medium hover:border-blue-500 hover:text-blue-500 transition-all"
            data-category={category}
          >
            {category}
          </button>
        ))
      }
    </div>

    <!-- Courses Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        courses.length > 0 ? (
          courses.map((course) => (
            // Add wrapper div with data-course-category for filtering and class for animation target
            <div
              class="course-card-wrapper opacity-0"
              data-course-category={course.category}
            >
              <CourseCard course={course} />
            </div>
          ))
        ) : (
          <div class="col-span-full text-center py-12">
            <p class="text-lg text-gray-600">
              No hay cursos disponibles en este momento
            </p>
          </div>
        )
      }
    </div>

    <!-- View More Button -->
    <div class="text-center mt-12 animate-element">
      <button
        class="px-8 py-3 bg-blue-600 text-white rounded-full font-medium hover:bg-blue-700 transition-all transform hover:scale-105"
      >
        Ver Catálogo Completo
      </button>
    </div>
  </div>
</section>
