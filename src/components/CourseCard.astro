---
const { course } = Astro.props;
---

<article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
  <div class="p-6">
    <h2 class="text-xl font-semibold mb-2">{course.name}</h2>
    <span class="inline-block px-3 py-1 text-sm font-semibold text-white bg-blue-500 rounded-full mb-3">
      {course.category}
    </span>
    <p class="text-gray-600 mb-4">{course.description}</p>
    <div class="flex justify-between items-center">
      <span class="text-sm text-gray-500">{course.duration} horas</span>
      <span class="text-sm font-medium">Prof. {course.instructor}</span>
    </div>
  </div>
</article>
