---
/**
 * CourseCard Component
 *
 * Displays a single course with its details in a card format.
 *
 * @prop {Course} course - The course object containing details to display.
 */
interface Course {
  id: number;
  name: string;
  category: string;
  description: string | null; // Assuming description can be null based on API docs
  duration: number;
  instructor: string;
  // createdAt?: string | Date; // Optional, depending if needed for display
}

const { course } = Astro.props as { course: Course };
---

<article
  class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow"
>
  <div class="p-6">
    <h2 class="text-xl font-semibold mb-2">{course.name}</h2>
    <span
      class="inline-block px-3 py-1 text-sm font-semibold text-white bg-blue-500 rounded-full mb-3"
    >
      {course.category}
    </span>
    <!-- Only display description if it exists -->
    {
      course.description && (
        <p class="text-gray-600 mb-4">{course.description}</p>
      )
    }
    <div class="flex justify-between items-center">
      <span class="text-sm text-gray-500">{course.duration} horas</span>
      <span class="text-sm font-medium">Prof. {course.instructor}</span>
    </div>
  </div>
</article>
