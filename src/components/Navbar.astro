---
// Static navbar without imported mobile menu component
---

<nav
  class="absolute top-0 left-0 w-full py-6 px-4 md:px-12 flex justify-between items-center z-50 bg-transparent"
>
  <div class="text-3xl font-bold tracking-wider">
    <span class="text-green-400">MAD</span>
    <span class="text-blue-400">F</span>
    <span class="text-orange-400">AM</span>
  </div>

  <!-- Desktop Navigation -->
  <div class="hidden md:flex space-x-8 text-lg">
    <a href="#acerca" class="text-white hover:text-gray-300 transition-colors"
      >Acerca</a
    >
    <a
      href="#fabricacion"
      class="text-white hover:text-gray-300 transition-colors"
      >Fabricación Sostenible</a
    >
    <a
      href="#transformacion"
      class="text-white hover:text-gray-300 transition-colors"
      >Transformación Digital</a
    >
    <a
      href="#solarpunk"
      class="text-white hover:text-gray-300 transition-colors"
      >Filosofía Solarpunk</a
    >
    <a
      href="#certificaciones"
      class="text-white hover:text-gray-300 transition-colors"
      >Certificaciones</a
    >
  </div>

  <!-- Mobile Menu Toggle -->
  <button
    id="mobile-menu-button"
    class="md:hidden text-2xl cursor-pointer text-white"
    aria-label="Open menu"
  >
    <i class="fas fa-bars"></i>
  </button>
</nav>

<!-- Mobile Menu (Simple Static Version) -->
<div
  id="mobile-menu"
  class="fixed top-0 left-0 w-full h-screen bg-gray-900 text-white z-50 transform transition-transform duration-300 translate-x-full"
>
  <div class="flex justify-end p-6">
    <button id="mobile-menu-close" class="text-2xl" aria-label="Close menu">
      <i class="fas fa-times"></i>
    </button>
  </div>

  <div class="flex flex-col items-center space-y-8 p-8">
    <a
      href="#acerca"
      class="mobile-menu-link text-2xl hover:text-blue-400 transition-colors"
      >Acerca</a
    >
    <a
      href="#fabricacion"
      class="mobile-menu-link text-2xl hover:text-blue-400 transition-colors"
      >Fabricación Sostenible</a
    >
    <a
      href="#transformacion"
      class="mobile-menu-link text-2xl hover:text-blue-400 transition-colors"
      >Transformación Digital</a
    >
    <a
      href="#solarpunk"
      class="mobile-menu-link text-2xl hover:text-blue-400 transition-colors"
      >Filosofía Solarpunk</a
    >
    <a
      href="#certificaciones"
      class="mobile-menu-link text-2xl hover:text-blue-400 transition-colors"
      >Certificaciones</a
    >
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const menuButton = document.getElementById('mobile-menu-button');
    const closeButton = document.getElementById('mobile-menu-close');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuLinks = document.querySelectorAll('.mobile-menu-link');

    if (menuButton && mobileMenu) {
      // Open menu when button is clicked
      menuButton.addEventListener('click', function () {
        mobileMenu.classList.remove('translate-x-full');
        mobileMenu.classList.add('translate-x-0');
      });

      // Close menu when close button is clicked
      if (closeButton) {
        closeButton.addEventListener('click', function () {
          mobileMenu.classList.add('translate-x-full');
          mobileMenu.classList.remove('translate-x-0');
        });
      }

      // Close menu when links are clicked
      menuLinks.forEach(function (link) {
        link.addEventListener('click', function () {
          mobileMenu.classList.add('translate-x-full');
          mobileMenu.classList.remove('translate-x-0');
        });
      });
    }
  });
</script>
