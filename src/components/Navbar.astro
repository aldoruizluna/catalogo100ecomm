---
import MobileMenu from './MobileMenu.astro';

let mobileMenuOpen = false;
---
<nav class="absolute top-0 left-0 w-full py-6 px-4 md:px-12 flex justify-between items-center z-50 bg-transparent">
  <div class="text-3xl font-bold tracking-wider">
    <span class="text-green-400">MAD</span>
    <span class="text-blue-400">F</span>
    <span class="text-orange-400">AM</span>
  </div>

  <!-- Desktop Navigation -->
  <div class="hidden md:flex space-x-8 text-lg">
    <a href="#acerca" class="text-white hover:text-gray-300 transition-colors">Acerca</a>
    <a href="#fabricacion" class="text-white hover:text-gray-300 transition-colors">Fabricación Sostenible</a>
    <a href="#transformacion" class="text-white hover:text-gray-300 transition-colors">Transformación Digital</a>
    <a href="#solarpunk" class="text-white hover:text-gray-300 transition-colors">Filosofía Solarpunk</a>
    <a href="#certificaciones" class="text-white hover:text-gray-300 transition-colors">Certificaciones</a>
  </div>

  <!-- Mobile Menu Toggle -->
  <button class="md:hidden text-2xl cursor-pointer text-white" onclick="mobileMenuOpen = !mobileMenuOpen">
    <i class="fas fa-bars"></i>
  </button>

  <MobileMenu client:load {mobileMenuOpen} />
</nav>
