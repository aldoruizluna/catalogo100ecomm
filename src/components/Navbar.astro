---
import MobileMenu from './MobileMenu.astro';
---

<nav
  class="absolute top-0 left-0 w-full py-6 px-4 md:px-12 flex justify-between items-center z-50 bg-transparent"
>
  <div class="text-3xl font-bold tracking-wider">
    <span class="text-green-400">MAD</span>
    <span class="text-blue-400">F</span>
    <span class="text-orange-400">AM</span>
  </div>

  <!-- Desktop Navigation -->
  <div class="hidden md:flex space-x-8 text-lg">
    <a href="#acerca" class="text-white hover:text-gray-300 transition-colors"
      >Acerca</a
    >
    <a
      href="#fabricacion"
      class="text-white hover:text-gray-300 transition-colors"
      >Fabricación Sostenible</a
    >
    <a
      href="#transformacion"
      class="text-white hover:text-gray-300 transition-colors"
      >Transformación Digital</a
    >
    <a
      href="#solarpunk"
      class="text-white hover:text-gray-300 transition-colors"
      >Filosofía Solarpunk</a
    >
    <a
      href="#certificaciones"
      class="text-white hover:text-gray-300 transition-colors"
      >Certificaciones</a
    >
  </div>

  <!-- Mobile Menu Toggle -->
  <button
    id="mobile-menu-button"
    class="md:hidden text-2xl cursor-pointer text-white"
  >
    <i class="fas fa-bars"></i>
  </button>

  <MobileMenu client:load id="mobile-menu" />
</nav>

<script>
  const menuButton = document.querySelector('#mobile-menu-button');
  const mobileMenu = document.querySelector('#mobile-menu');

  if (menuButton && mobileMenu) {
    menuButton.addEventListener('click', () => {
      mobileMenu.classList.toggle('translate-x-full');
      mobileMenu.classList.toggle('translate-x-0');
    });

    // Add event listeners to close buttons/links inside the mobile menu
    const closeElements = mobileMenu.querySelectorAll('button, a');
    closeElements.forEach((el) => {
      el.addEventListener('click', () => {
        mobileMenu.classList.add('translate-x-full');
        mobileMenu.classList.remove('translate-x-0');
      });
    });
  }
</script>
