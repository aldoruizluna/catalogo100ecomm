---
import db from '../../db';
import { courses } from '../../db/schema';

// GET handler for debugging purposes
export async function GET() {
  try {
    // Check database connection and content
    console.log('DEBUG: Checking database contents...');

    // 1. Count courses
    const countResult = await db.select().from(courses).all();
    const courseCount = countResult.length;
    console.log(`DEBUG: Course count: ${courseCount}`);

    // 2. List all courses
    const allCourses = await db.select().from(courses).all();
    console.log('DEBUG: All courses:', JSON.stringify(allCourses, null, 2));

    // Return detailed information for debugging
    return new Response(
      JSON.stringify({
        count: courseCount,
        courses: allCourses,
        dbInfo: {
          location: process.cwd(),
          timestamp: new Date().toISOString(),
        },
      }),
      {
        status: 200,
        headers: {
          'Content-Type': 'application/json; charset=utf-8',
        },
      }
    );
  } catch (error) {
    console.error('DEBUG ERROR:', error);
    return new Response(JSON.stringify({ error: String(error) }), {
      status: 500,
      headers: {
        'Content-Type': 'application/json; charset=utf-8',
      },
    });
  }
}
---
