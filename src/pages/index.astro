---
// Components
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import AboutSection from '../components/AboutSection.astro';
import CoursesSection from '../components/CoursesSection.astro';

// Database Imports
import db from '../db';
import { courses as coursesTable } from '../db/schema'; // Import the schema

// Fetch courses from the database during server-side rendering
let courses = [];
try {
  courses = await db.select().from(coursesTable).all();
  console.log('Fetched courses from DB:', courses.length);
} catch (error) {
  console.error('Error fetching courses from DB:', error);
  // Optionally handle the error, e.g., show a message or default data
}
---

<BaseLayout title="MADFAM - Catálogo Completo de Cursos">
  <HeroSection />
  <AboutSection />
  <CoursesSection courses={courses} />
</BaseLayout>
